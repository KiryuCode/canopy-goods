<%- include('partials/header') %>

  <section class="hero">
    <p class="hero-kicker">Quiet greenhouse stock</p>
    <h1 class="hero-title">Grow<br>something<br>that stays.</h1>
    <p class="hero-lede">Houseplants for bright corners. Ferns for the humid shelf. Citrus for the sunlit window. Herbs, succulents, and the pots to plant them in.</p>
    <nav class="hero-cats" aria-label="Catalog sections">
      <a href="#houseplants">Houseplants</a>
      <a href="#ferns">Ferns</a>
      <a href="#citrus">Citrus</a>
      <a href="#herbs">Herbs</a>
      <a href="#succulents">Succulents</a>
      <a href="#pots-tools">Pots &amp; Tools</a>
    </nav>
  </section>

  <%
    function catId(name) {
      return String(name || "shop").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/-+$/g, "");
    }
  %>

  <% (typeof categories !== 'undefined' && categories.length ? categories : [{ name: 'Shop', products: products }]).forEach(function (group) { %>
    <section class="catalog-section" id="<%= catId(group.name) %>">
      <h2 class="category-title"><%= group.name %></h2>
      <div class="product-grid">
        <% group.products.forEach(function (product) { %>
          <article class="product-card">
            <div class="product-media">
              <img
                class="product-image"
                src="<%= product.image %>"
                alt="<%= product.name %>"
                loading="lazy"
                width="800"
                height="520"
              >
            </div>
            <div class="product-body">
              <h3 class="product-name"><%= product.name %></h3>
              <p class="product-desc"><%= product.description %></p>
              <p class="product-stock<%= product.qtyAvailable < 1 ? ' product-stock-out' : '' %>">
                <%= product.qtyAvailable < 1 ? 'Out of stock' : product.qtyAvailable + ' available' %>
              </p>
              <div class="product-footer">
                <span class="price">$<%= formatPrice(product.price) %></span>
                <div class="product-actions">
                  <% if (product.qtyAvailable > 0) { %>
                    <form method="post" action="/cart/add" class="inline-form js-add-to-cart">
                      <%- include('partials/csrf') %>
                      <input type="hidden" name="product_id" value="<%= product.id %>">
                      <input type="hidden" name="redirect" value="shop">
                      <button type="submit" class="btn btn-secondary btn-sm">Add to Cart</button>
                    </form>
                    <a class="btn btn-primary btn-sm" href="/buy/<%= product.id %>">Buy Now</a>
                  <% } else { %>
                    <span class="btn btn-secondary btn-sm" style="opacity:0.55;cursor:not-allowed;">Unavailable</span>
                  <% } %>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>

<%- include('partials/footer') %>
