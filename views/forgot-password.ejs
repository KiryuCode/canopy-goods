<%- include('partials/header') %>

  <h1 class="page-title">Forgot password</h1>
  <p class="page-sub">Enter the email on your account. If it matches, we will send a one-time reset link.</p>

  <div class="panel">
    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="alert alert-success">If that email is on an account, a reset link is on the way. Check your inbox (and spam) in a minute.</div>
      <div class="actions">
        <a class="btn btn-secondary" href="/login">Back to sign in</a>
      </div>
    <% } else { %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="post" action="/forgot-password">
        <%- include('partials/csrf') %>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-primary">Send reset link</button>
          <a class="btn btn-secondary" href="/login">Cancel</a>
        </div>
      </form>
    <% } %>
  </div>

<%- include('partials/footer') %>
