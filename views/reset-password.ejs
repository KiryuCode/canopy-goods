<%- include('partials/header') %>

  <p class="auth-kicker">Account</p>
  <h1 class="page-title">Choose a new password</h1>
  <p class="page-sub">This link works once. Pick something at least 8 characters.</p>

  <div class="panel">
    <% if (typeof invalid !== 'undefined' && invalid) { %>
      <div class="alert alert-error">This reset link is invalid or expired. Request a new one.</div>
      <div class="actions">
        <a class="btn btn-primary" href="/forgot-password">Request a new link</a>
      </div>
    <% } else if (typeof done !== 'undefined' && done) { %>
      <div class="alert alert-success">Password updated. You can sign in now.</div>
      <div class="actions">
        <a class="btn btn-primary" href="/login">Sign in</a>
      </div>
    <% } else { %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="post" action="/reset-password">
        <%- include('partials/csrf') %>
        <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>">
        <div class="form-group">
          <label for="password">New password</label>
          <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="password2">Confirm password</label>
          <input type="password" id="password2" name="password2" required minlength="8" autocomplete="new-password">
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-primary">Update password</button>
        </div>
      </form>
    <% } %>
  </div>

<%- include('partials/footer') %>
